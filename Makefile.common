# The files that are not on every platform
SOURCES_GLSLANG_UNIX    := $(CORE_DIR)/3rdparty/glslang/glslang/glslang/OSDependent/Unix/ossource.cpp
SOURCES_GLSLANG_WINDOWS := $(CORE_DIR)/3rdparty/glslang/glslang/glslang/OSDependent/Windows/ossource.cpp

SOURCES_LIBUSB_LINUX   := $(addprefix $(CORE_DIR)/3rdparty/libusb/libusb/libusb/os/,linux_usbfs.c linux_netlink.c threads_posix.c events_posix.c)
SOURCES_LIBUSB_DARWIN  := $(addprefix $(CORE_DIR)/3rdparty/libusb/libusb/libusb/os/,darwin_usb.c threads_posix.c events_posix.c)
SOURCES_LIBUSB_WINDOWS := $(addprefix $(CORE_DIR)/3rdparty/libusb/libusb/libusb/os/,events_windows.c windows_usbdk.c windows_common.c windows_winusb.c threads_windows.c)

SOURCES_RPCS3_AARCH64 := $(addprefix $(CORE_DIR)/rpcs3/Emu/CPU/Backends/AArch64/,AArch64ASM.cpp AArch64Common.cpp AArch64JIT.cpp AArch64Signal.cpp)
SOURCES_RPCS3_DARWIN  := $(CORE_DIR)/darwin/util/sysinfo_darwin.mm $(CORE_DIR)/rpcs3/Emu/RSX/VK/vkutils/metal_layer.mm

# The video unit: OpenGL, or the same interface without it where there is
# no desktop GL renderer (macOS, which draws through MoltenVK)
SOURCES_LIBRETRO_GL   := $(CORE_DIR)/rpcs3/libretro/libretro_video.cpp $(CORE_DIR)/rpcs3/libretro/libretro_gl_frames.c \
	$(CORE_DIR)/rpcs3/libretro/libretro_gl_fallback.c
SOURCES_LIBRETRO_NOGL := $(CORE_DIR)/rpcs3/libretro/libretro_video_sw.cpp

# Made by the build (rpcs3/libretro/make/embed.c): the data compiled in
GEN_DIR := $(CORE_DIR)/rpcs3/libretro/generated
SOURCES_GENERATED := \
	$(GEN_DIR)/libretro_ui_icons.cpp \
	$(GEN_DIR)/libretro_config_database.cpp \
	$(GEN_DIR)/libretro_patches.cpp \
	$(GEN_DIR)/libretro_vblank_unlock.cpp

# Per-library flags, as each library's CMake target has them
FLAGS_LRC     := -std=gnu99 -DHAVE_SSL -DHAVE_RETROSSL -DHAVE_CRYPTO \
	-DHAVE_RWAV -DHAVE_RFLAC -DHAVE_RVORBIS -DHAVE_ROPUS -DHAVE_RMP3 -DHAVE_RAAC \
	-DHAVE_RMP4 -DHAVE_RAC3 -DHAVE_RWMA -DHAVE_RWEBM -DHAVE_RATRAC3 -DHAVE_RATRAC3P \
	-I$(CORE_DIR)/rpcs3/libretro/libretro-common/include
FLAGS_LIBUSB  := -std=gnu99 -fvisibility=hidden -w \
	-I$(CORE_DIR)/rpcs3/libretro/make/libusb \
	-I$(CORE_DIR)/3rdparty/libusb/libusb/libusb \
	-I$(CORE_DIR)/3rdparty/libusb/libusb/libusb/os
FLAGS_GLSLANG := -std=c++17 -fno-rtti -fno-exceptions -w -DENABLE_OPT=0 -DENABLE_SPIRV \
	-I$(CORE_DIR)/3rdparty/glslang/glslang \
	-I$(CORE_DIR)/rpcs3/libretro/make/include
# asmjit and RtMidi are linked into the core, not their own DLLs: without
# ASMJIT_STATIC, and with RtMidi's RTMIDI_EXPORT, a Windows core exports their
# classes along with its retro_* functions
FLAGS_ASMJIT  := -std=gnu++20 -w -DASMJIT_STATIC -isystem $(CORE_DIR)/3rdparty/asmjit/asmjit/src
FLAGS_RTMIDI  := -std=c++11 -w -I$(CORE_DIR)/3rdparty/rtmidi/rtmidi
FLAGS_FUSION  := -w -I$(CORE_DIR)/3rdparty/fusion/fusion/Fusion
# Vulkan's headers and volk from the tree: nothing to install.
# volk loads the Vulkan functions at run time; the core links no loader.
FLAGS_VOLK    := -std=gnu99 -w -DVK_NO_PROTOTYPES -isystem $(CORE_DIR)/3rdparty/Vulkan-Headers/include

# RPCS3 itself (rpcs3_emu) and the core's own files (rpcs3_libretro)
INCLUDES_RPCS3 := \
	-I$(CORE_DIR) \
	-I$(CORE_DIR)/rpcs3 \
	-I$(CORE_DIR)/3rdparty \
	-I$(CORE_DIR)/3rdparty/libusb/libusb/libusb \
	-I$(CORE_DIR)/rpcs3/libretro/libretro-common/include \
	-I$(CORE_DIR)/3rdparty/glslang/glslang \
	-I$(CORE_DIR)/rpcs3/libretro/make/include \
	-I$(CORE_DIR)/3rdparty/rtmidi/rtmidi \
	-isystem $(CORE_DIR)/3rdparty/asmjit/asmjit/src \
	-isystem $(CORE_DIR)/3rdparty/GL \
	-isystem $(CORE_DIR)/3rdparty/GPUOpen/VulkanMemoryAllocator/include \
	-isystem $(CORE_DIR)/3rdparty/Vulkan-Headers/include \
	-isystem $(CORE_DIR)/3rdparty/volk
INCLUDES_LIBRETRO := \
	-I$(CORE_DIR)/rpcs3/Emu \
	-I$(CORE_DIR)/rpcs3/libretro \
	-I$(CORE_DIR)/3rdparty/fusion/fusion/Fusion

# buildfiles/cmake/ConfigureCompiler.cmake's; the Makefile adds GCC's or
# Clang's own
WARNINGS_RPCS3 := -Wall -Werror=old-style-cast -Werror=sign-compare \
	-Werror=reorder -Werror=return-type -Werror=overloaded-virtual -Werror=missing-noreturn \
	-Werror=implicit-fallthrough -Wunused-parameter -Wignored-qualifiers -Wredundant-move \
	-Wcast-qual -Wdeprecated-copy -Wtautological-compare -Wempty-body -Wredundant-decls \
	-Wstrict-aliasing=1
WARNINGS_GCC   := -Werror=suggest-override -Wclobbered -Wduplicated-branches -Wduplicated-cond \
	-Wno-class-memaccess
WARNINGS_CLANG := -Werror=inconsistent-missing-override -Werror=delete-non-virtual-dtor \
	-fconstexpr-steps=16777216 -Wno-unused-lambda-capture -Wno-unused-private-field \
	-Wno-unused-command-line-argument -Wno-elaborated-enum-base
